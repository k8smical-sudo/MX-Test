+    /** Casilla de un hueco sin chunk cargado: sólida, de equipo 0, de patas y totalmente profunda => infranqueable para suelo, patas, neoplasma y hover. */
+    private static final int unloadedPathTile = PathTile.get(0, 0, true, false, true, false, false, false, false, false, false, true, false, false);
+
     public int get(int x, int y){
+        //en anillo un (x, y) sin chunk podría coincidir con el hueco de OTRO chunk (alias): se trata como no cargado
+        if(world.tiles.ring) return world.tiles.in(x, y) ? tiles[world.tiles.index(x, y)] : unloadedPathTile;
         return tiles[x + y * wwidth];
     }
 
+    /** Mundos en anillo: reempaqueta un chunk recién publicado y el borde de 1 casilla de sus vecinos (packTile mira 4 vecinos y diagonales). */
+    private void packChunk(int cx, int cy){
+        int x0 = cx << Tiles.chunkBits, y0 = cy << Tiles.chunkBits, n = Tiles.chunkSize;
+        for(int y = y0; y < y0 + n; y++){
+            for(int x = x0; x < x0 + n; x++){
+                Tile t = world.tiles.get(x, y);
+                if(t != null) tiles[t.array()] = packTile(t);
+            }
+        }
+        for(int i = -1; i <= n; i++){
+            for(int[] e : new int[][]{{x0 + i, y0 - 1}, {x0 + i, y0 + n}, {x0 - 1, y0 + i}, {x0 + n, y0 + i}}){
+                Tile t = world.tiles.get(e[0], e[1]);
+                if(t != null) tiles[t.array()] = packTile(t);
+            }
+        }
+        needsRefresh = true;
+    }
+
+    /** Mundos en anillo: antes de liberar un chunk (sus casillas aún existen) sus huecos pasan a "no cargado". */
+    private void unpackChunk(int cx, int cy){
+        int x0 = cx << Tiles.chunkBits, y0 = cy << Tiles.chunkBits, n = Tiles.chunkSize;
+        for(int y = y0; y < y0 + n; y++){
+            for(int x = x0; x < x0 + n; x++){
+                Tile t = world.tiles.get(x, y);
+                if(t != null) tiles[t.array()] = unloadedPathTile;
+            }
+        }
+        needsRefresh = true;
+    }
+
