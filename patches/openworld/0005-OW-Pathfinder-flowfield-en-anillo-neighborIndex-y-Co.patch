+    /** Índice de flowfield de (x, y). En un mundo en anillo (resolución 1) es el índice del anillo, o -1 si su chunk no está cargado. */
+    private int flowIndex(int x, int y, int res, int ww){
+        if(world.tiles.ring) return world.tiles.in(x, y) ? world.tiles.index(x, y) : -1;
+        return x / res + y / res * ww;
+    }
+
+    private boolean passableAt(Flowfield path, int pos){
+        return pos >= 0 && path.passable(pos);
