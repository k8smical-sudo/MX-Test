+    /**
+     * Índice de la casilla vecina (dx, dy) de la casilla de índice {@code idx}, o -1 si no existe (fuera del mapa, o chunk no cargado).
+     * Es la forma de recorrer vecinos sin deducir coordenadas del índice: en anillo busca la casilla por su (x, y) VIRTUAL, así que la
+     * costura del anillo no es una pared ni se conectan dos regiones que solo son adyacentes en el búfer pero están lejos en el mundo.
+     */
+    public int neighborIndex(int idx, int dx, int dy){
+        if(ring){
+            Tile t = array[idx];
+            if(t == null) return -1;
+            int nx = t.x + dx, ny = t.y + dy;
+            return in(nx, ny) ? ((nx & mask) | ((ny & mask) << bits)) : -1;
+        }
+        int x = idx % width + dx, y = idx / width + dy;
+        return (x < 0 || y < 0 || x >= width || y >= height) ? -1 : x + y * width;
+    }
