+    // ---------------------------------------------------------------- mapas de bits por casilla (niebla, etc.), indexados con index()
+
+    /**
+     * Pone a 1 en {@code arr} los bits de las casillas de la fila virtual {@code y}, entre x1 y x2 (inclusive, en cualquier orden),
+     * SOLO de las que tienen su chunk cargado: en un anillo un hueco sin chunk podría ser el de otro chunk (alias) y no se debe tocar.
+     * Equivale a {@code arr.set(y * width + x1, y * width + x2 + 1)} de un mapa normal, pero sin salirse del chunk ni de la costura.
+     */
+    public void setBitsRow(Bits arr, int x1, int x2, int y){
+        if(!ring) throw new UnsupportedOperationException("setBitsRow is only for ring mode");
+        if(x1 > x2){
+            int tmp = x1;
+            x1 = x2;
+            x2 = tmp;
+        }
+        if(y < minCoord || y > maxCoord) return;
+        if(x1 < minCoord) x1 = minCoord;
+        if(x2 > maxCoord) x2 = maxCoord;
+        if(x1 > x2) return;
+        int cy = y >> chunkBits, base = (y & mask) << bits;
+        for(int cx = x1 >> chunkBits, last = x2 >> chunkBits; cx <= last; cx++){
+            if(owner[slotOf(cx, cy)] != packChunk(cx, cy)) continue;
+            int a = Math.max(x1, cx << chunkBits), b = Math.min(x2, (cx << chunkBits) + chunkSize - 1);
+            arr.set(base | (a & mask), (base | (b & mask)) + 1);   //dentro de un chunk las casillas de una fila son contiguas, sin vuelta
+        }
+    }
+
+    /** Copia los bits del chunk cargado (cx, cy) a {@code out} (16 longs): el bit ly*32+lx del chunk es el bit (ly*32+lx)&63 de out[(ly*32+lx)>>6]. Chunk no cargado: ceros. */
+    public void readChunkBits(Bits arr, int cx, int cy, long[] out){
+        if(!ring) throw new UnsupportedOperationException("readChunkBits is only for ring mode");
+        Arrays.fill(out, 0, 16, 0L);
+        if(!chunkLoaded(cx, cy)) return;
+        int x0 = cx << chunkBits, y0 = cy << chunkBits, col = x0 & mask;
+        for(int ly = 0; ly < chunkSize; ly++){
+            int row = (((y0 + ly) & mask) << bits) | col;
+            for(int lx = 0; lx < chunkSize; lx++){
+                if(arr.get(row + lx)){
+                    int k = (ly << chunkBits) + lx;
+                    out[k >> 6] |= 1L << (k & 63);
+                }
+            }
+        }
+    }
+
+    /** Suma (OR) a {@code arr} los bits de {@code in} (formato de {@link #readChunkBits}) en el chunk cargado (cx, cy). No borra los que ya estuvieran puestos. */
+    public void writeChunkBits(Bits arr, int cx, int cy, long[] in){
+        if(!ring) throw new UnsupportedOperationException("writeChunkBits is only for ring mode");
+        if(!chunkLoaded(cx, cy)) return;
+        int x0 = cx << chunkBits, y0 = cy << chunkBits, col = x0 & mask;
+        for(int ly = 0; ly < chunkSize; ly++){
+            int row = (((y0 + ly) & mask) << bits) | col;
+            for(int lx = 0; lx < chunkSize; lx++){
+                int k = (ly << chunkBits) + lx;
+                if((in[k >> 6] & (1L << (k & 63))) != 0) arr.set(row + lx);
+            }
+        }
+    }
+
+    /** Pone a 0 en {@code arr} los bits del chunk cargado (cx, cy). Si el chunk no está cargado no hace nada (su hueco puede ser de otro). */
+    public void clearChunkBits(Bits arr, int cx, int cy){
+        if(!ring) throw new UnsupportedOperationException("clearChunkBits is only for ring mode");
+        if(!chunkLoaded(cx, cy)) return;
+        int x0 = cx << chunkBits, y0 = cy << chunkBits, col = x0 & mask;
+        for(int ly = 0; ly < chunkSize; ly++){
+            int row = (((y0 + ly) & mask) << bits) | col;
+            for(int lx = 0; lx < chunkSize; lx++) arr.clear(row + lx);
+        }
+    }
+
