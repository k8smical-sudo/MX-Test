+    /** Casilla del búfer: en un mundo en anillo las coordenadas virtuales se pliegan sobre el lado del anillo (potencia de 2). */
+    private static int rx(int v){
+        return world.isRing() ? v & (world.width() - 1) : v;
+    }
+
+    /** En anillo las texturas del tamaño del mundo se repiten, así cubren todas las coordenadas virtuales. */
+    private static void ringWrap(FrameBuffer buffer){
+        if(world.isRing()) buffer.getTexture().setWrap(TextureWrap.repeat, TextureWrap.repeat);
+    }
+
+    /** Límites de los índices espaciales: el mapa denso, o todo el rango de coordenadas virtuales en un mundo en anillo. */
+    private static Rect indexBounds(){
+        if(world.isRing()){
+            float pad = 16f * tilesize;
+            float min = Tiles.minCoord * tilesize - pad, size = (Tiles.maxCoord - Tiles.minCoord + 1) * tilesize + pad * 2f;
+            return new Rect(min, min, size, size);
+        }
+        return new Rect(0, 0, world.unitWidth(), world.unitHeight());
+    }
+
+    private boolean inChunk(Tile tile, int cx, int cy){
+        return tile != null && (tile.x >> Tiles.chunkBits) == cx && (tile.y >> Tiles.chunkBits) == cy;
+    }
+
+    /** Anillo: indexa de una vez las 1024 casillas del chunk recién publicado y pide repintar sus sombras y oscuridad. */
+    private void ringLoadChunk(int cx, int cy){
+        int x0 = cx << Tiles.chunkBits, y0 = cy << Tiles.chunkBits, n = Tiles.chunkSize;
+        for(int ly = 0; ly < n; ly++){
+            for(int lx = 0; lx < n; lx++){
+                Tile tile = world.tile(x0 + lx, y0 + ly);
+                if(tile == null) continue;
+
+                recordIndex(tile);
+
+                if(tile.floor().updateRender(tile)){
+                    updateFloors.add(new UpdateRenderState(tile, tile.floor()));
+                }
+
+                if(tile.overlay().updateRender(tile)){
+                    updateFloors.add(new UpdateRenderState(tile, tile.overlay()));
+                }
+            }
+        }
+
+        ringShadowChunks.add(cx);
+        ringShadowChunks.add(cy);
+        ringDarkChunks.add(cx);
+        ringDarkChunks.add(cy);
+        lastCamY = lastCamX = -99; //invalidate camera position so blocks get updated
+    }
+
+    /** Anillo: las casillas del chunk siguen existiendo en este punto; se quitan de los índices antes de que se suelte su hueco. */
+    private void ringUnloadChunk(int cx, int cy){
+        int x0 = cx << Tiles.chunkBits, y0 = cy << Tiles.chunkBits, n = Tiles.chunkSize;
+        for(int ly = 0; ly < n; ly++){
+            for(int lx = 0; lx < n; lx++){
+                Tile tile = world.tile(x0 + lx, y0 + ly);
+                if(tile == null) continue;
+
+                if(indexBlock(tile)){
+                    blockTree.remove(tile);
+                    blockLightTree.remove(tile);
+                }
+                if(indexBlockCached(tile)) blockCachedTree.remove(tile);
+                if(indexFloor(tile)) floorTree.remove(tile);
+                if(indexOverlay(tile)) overlayTree.remove(tile);
+            }
+        }
+
+        updateFloors.removeAll(u -> inChunk(u.tile, cx, cy));
+        shadowEvents.removeAll(tile -> inChunk(tile, cx, cy));
+        lastCamY = lastCamX = -99;
+    }
+
