diff --git a/core/src/mindustry/world/ChunkDarkness.java b/core/src/mindustry/world/ChunkDarkness.java
new file mode 100644
index 0000000000000000000000000000000000000000..42c2d8d41295d6f9fabd75f30e6031ecaa472955
--- /dev/null
+++ b/core/src/mindustry/world/ChunkDarkness.java
@@ -0,0 +1,76 @@
+package mindustry.world;
+
+/**
+ * Oscuridad de muros por chunk, para mundos en anillo. Es la misma función que {@code World.addDarkness}, pero sobre un plano
+ * INFINITO y por chunk, y sin tocar el mundo: se puede ejecutar en un hilo de fondo con el terreno que ya conoce el generador
+ * (también el de los chunks vecinos aún sin cargar), así el resultado es exacto desde el principio y no hay que recalcular los bordes
+ * cuando un vecino se carga después. El resultado va en el parámetro {@code data} del constructor crudo de {@link Tile}.
+ * <p>
+ * Semántica de vanilla: una casilla "oscurecible" ({@code Tile.isDarkened()}) recibe un nivel = min(darkRadius, distancia
+ * Manhattan por vecinos de 4 hasta la casilla no oscurecible más cercana); y si es nivel máximo y sus 4 vecinas son también
+ * oscurecibles de nivel máximo, vale darkRadius + 1. Las no oscurecibles no cambian (0).
+ */
+public final class ChunkDarkness{
+    public static final int darkRadius = 4;   //igual que Vars.darkRadius
+    /** Casillas de contexto necesarias alrededor del chunk. El nivel de una casilla depende de las casillas oscurecibles hasta
+     *  darkRadius de distancia (la información avanza una casilla por iteración), y la comprobación de "llena" mira el nivel de un
+     *  vecino, que depende de otras hasta darkRadius más allá: darkRadius + 1. Con menos deja de ser exacto: ver las pruebas. */
+    public static final int margin = darkRadius + 1;
+    public static final int padded = Tiles.chunkSize + 2 * margin;
+
+    private ChunkDarkness(){}
+
+    /** Índice en el mapa {@code darkened} de la casilla local (lx, ly), con lx, ly en [-margin, chunkSize + margin). */
+    public static int paddedIndex(int lx, int ly){
+        return (ly + margin) * padded + (lx + margin);
+    }
+
+    /**
+     * @param darkened padded*padded: si cada casilla (el chunk y {@link #margin} de contexto a cada lado) es oscurecible
+     * @param out chunkSize*chunkSize (fila a fila): nivel de oscuridad de cada casilla del chunk (0 si no es oscurecible)
+     * @param dark búfer de trabajo padded*padded (reutilizable entre llamadas)
+     * @param buf otro búfer de trabajo padded*padded
+     * @return true si el chunk es MACIZO: todas sus casillas están en el nivel máximo (darkRadius + 1), es decir, roca a más de
+     * darkRadius casillas de cualquier hueco. No se ve, no se puede alcanzar por tierra ni construir en él: no hace falta publicarlo.
+     * En un mundo en anillo una casilla ausente ya es sólida y oscura (World.solid, EntityCollisions.solid y Build.validPlace tratan
+     * null como "no"), así que dejarlo sin publicar ahorra su memoria, su generación de casillas y todos los índices.
+     */
+    public static boolean compute(boolean[] darkened, byte[] out, byte[] dark, byte[] buf){
+        final int n = padded;
+        for(int i = 0; i < n * n; i++) dark[i] = darkened[i] ? (byte)darkRadius : 0;
+
+        for(int it = 0; it < darkRadius; it++){
+            for(int y = 0; y < n; y++){
+                for(int x = 0; x < n; x++){
+                    int i = y * n + x;
+                    byte d = dark[i];
+                    boolean lower = (x > 0 && dark[i - 1] < d) || (x < n - 1 && dark[i + 1] < d)
+                        || (y > 0 && dark[i - n] < d) || (y < n - 1 && dark[i + n] < d);
+                    buf[i] = (byte)Math.max(0, d - (lower ? 1 : 0));
+                }
+            }
+            System.arraycopy(buf, 0, dark, 0, n * n);
+        }
+
+        boolean macizo = true;
+        for(int ly = 0; ly < Tiles.chunkSize; ly++){
+            for(int lx = 0; lx < Tiles.chunkSize; lx++){
+                int i = paddedIndex(lx, ly);
+                byte v = 0;
+                if(darkened[i]){
+                    v = dark[i];
+                    if(dark[i] == darkRadius){
+                        boolean full = true;
+                        //en vanilla `tiles.in(...)` siempre es cierto aquí: el plano es infinito
+                        if(!(darkened[i - 1] && dark[i - 1] == 4) || !(darkened[i + 1] && dark[i + 1] == 4)
+                            || !(darkened[i - n] && dark[i - n] == 4) || !(darkened[i + n] && dark[i + n] == 4)) full = false;
+                        if(full) v = (byte)(darkRadius + 1);
+                    }
+                }
+                out[ly * Tiles.chunkSize + lx] = v;
+                if(v != darkRadius + 1) macizo = false;
+            }
+        }
+        return macizo;
+    }
+}
