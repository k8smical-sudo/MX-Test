diff --git a/core/src/mindustry/graphics/RingFbo.java b/core/src/mindustry/graphics/RingFbo.java
new file mode 100644
index 0000000000000000000000000000000000000000..8c80ad39234ede626e65bc955f8a1a1f383b3617
--- /dev/null
+++ b/core/src/mindustry/graphics/RingFbo.java
@@ -0,0 +1,61 @@
+package mindustry.graphics;
+
+import arc.*;
+import arc.graphics.*;
+import arc.graphics.g2d.*;
+
+/**
+ * Dibuja sobre la pantalla una textura "del tamaño del mundo" (sombras, oscuridad, niebla) cuando el mundo es un ANILLO.
+ *
+ * {@code Draw.fbo} dibuja UN rectángulo cuya coordenada de textura es (posición de la cámara) / (lado del mundo): en un mundo
+ * en anillo esa coordenada crece sin límite (cámara en la casilla 30 000 -> u ~ 29) y el resultado solo es correcto si la textura
+ * está en {@code TextureWrap.repeat}. Ese modo se pierde con cada {@code FrameBuffer.resize()} / reconstrucción del contexto GL, y
+ * con UV grandes además se pierde precisión en la interpolación. Aquí no se depende de nada de eso: la pantalla se parte en las
+ * costuras del anillo y cada trozo se dibuja con UV siempre dentro de [0, 1] (como mucho 4 trozos). Es la misma imagen.
+ */
+final class RingFbo{
+    private static final TextureRegion region = new TextureRegion();
+
+    private RingFbo(){}
+
+    /**
+     * @param texture textura de lado {@code sideTiles} casillas (una casilla = un texel), voltereada como los FrameBuffer de Arc
+     * @param offset desplazamiento en unidades de mundo entre la cámara y el espacio de la textura (media casilla en sombras,
+     * oscuridad y niebla estática; 0 en niebla dinámica), el mismo que recibe {@code Draw.fbo}
+     */
+    static void draw(Texture texture, int sideTiles, int tilesize, float offset){
+        final Camera cam = Core.camera;
+        final double side = (double)sideTiles * tilesize;
+        final double halfW = cam.width / 2.0, halfH = cam.height / 2.0;
+        //espacio de la textura: es el del mundo desplazado por 'offset'
+        final double left = cam.position.x + (double)offset - halfW, right = cam.position.x + (double)offset + halfW;
+        final double bottom = cam.position.y + (double)offset - halfH, top = cam.position.y + (double)offset + halfH;
+
+        final long kx0 = (long)Math.floor(left / side), kx1 = (long)Math.floor(Math.nextDown(right) / side);
+        final long ky0 = (long)Math.floor(bottom / side), ky1 = (long)Math.floor(Math.nextDown(top) / side);
+        //tope de seguridad (una cámara absurdamente alejada): más de 8 x 8 trozos no tiene sentido
+        if(kx1 - kx0 > 8 || ky1 - ky0 > 8) return;
+
+        region.texture = texture;
+        for(long ky = ky0; ky <= ky1; ky++){
+            final double cellBottom = ky * side;
+            final double b = Math.max(bottom, cellBottom), t = Math.min(top, cellBottom + side);
+            if(t - b <= 1e-4) continue;
+            for(long kx = kx0; kx <= kx1; kx++){
+                final double cellLeft = kx * side;
+                final double a = Math.max(left, cellLeft), c = Math.min(right, cellLeft + side);
+                if(c - a <= 1e-4) continue;
+
+                final float u = (float)((a - cellLeft) / side), u2 = (float)((c - cellLeft) / side);
+                final float v = (float)((b - cellBottom) / side), v2 = (float)((t - cellBottom) / side);
+                //mismo volteo vertical que Draw.fbo: (u, v2) arriba-izquierda, (u2, v) abajo-derecha
+                region.set(u, v2, u2, v);
+
+                //destino en coordenadas de mundo (se quita el desplazamiento): el trozo cae justo donde estaba en el rectángulo único
+                final float w = (float)(c - a), h = (float)(t - b);
+                final float x = (float)((a + c) * 0.5 - offset), y = (float)((b + t) * 0.5 - offset);
+                Draw.rect(region, x, y, w, h);
+            }
+        }
+    }
+}
