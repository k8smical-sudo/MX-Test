+    /** Indexa el terreno de una casilla recién cargada: proceso general, suelo con flags y menas. (Antes iba dentro del bucle de WorldLoadEvent.) */
+    private void indexTerrain(Tile tile){
+        process(tile);
+
+        addFloorIndex(tile, tile.floor());
+
+        Item drop;
+        if(tile.block() == Blocks.air){
+            if((drop = tile.drop()) != null && ores.length > drop.id){
+                //add position of quadrant to list
+                oreSeq(false, drop.id, tile, true).add(tile.pos());
+                allOres.increment(drop);
+            }
+        }else if((drop = tile.wallDrop()) != null && wallOres.length > drop.id){
+            //add position of quadrant to list
+            oreSeq(true, drop.id, tile, true).add(tile.pos());
+            allWallOres.increment(drop);
+        }
+    }
+
+    /**
+     * Lista de menas del cuadrante de la casilla (de 20 casillas en un mapa normal; de 16 en un mundo en anillo), o null si no existe
+     * y {@code create} es false.
+     */
+    private @Nullable IntSeq oreSeq(boolean wall, int id, Tile tile, boolean create){
+        if(world.tiles.ring){
+            RingOreIndex idx = wall ? ringWallOres : ringOres;
+            return idx == null ? null : idx.seq(id, tile.x, tile.y, create);
+        }
+        IntSeq[][][] arr = wall ? wallOres : ores;
+        if(arr == null || id >= arr.length) return null;
+        int qx = tile.x / quadrantSize, qy = tile.y / quadrantSize;
+        if(arr[id] == null){
+            if(!create) return null;
+            arr[id] = new IntSeq[quadWidth][quadHeight];
+        }
+        if(arr[id][qx][qy] == null && create) arr[id][qx][qy] = new IntSeq(false, 16);
+        return arr[id][qx][qy];
+    }
+
+    /** Mundos en anillo: un chunk recién publicado entra al índice de una sola pasada (en vez de 1024 TileChangeEvent). */
+    private void indexChunk(int cx, int cy){
+        if(ores == null) return;
+        int x0 = cx << Tiles.chunkBits, y0 = cy << Tiles.chunkBits;
+        for(int y = y0; y < y0 + Tiles.chunkSize; y++){
+            for(int x = x0; x < x0 + Tiles.chunkSize; x++){
+                Tile tile = world.tiles.get(x, y);
+                if(tile != null) indexTerrain(tile);
+            }
+        }
+        updatePresentOres();
+    }
+
+    /** Mundos en anillo: antes de liberar un chunk (sus casillas aún existen) se quitan sus menas y sus suelos con flags. */
+    private void unindexChunk(int cx, int cy){
+        if(ores == null || ringOres == null) return;
+        for(int id = 0; id < ringOres.items(); id++){
+            int n = ringOres.dropChunk(id, cx, cy);
+            if(n > 0) allOres.increment(content.item(id), -n);
+            n = ringWallOres.dropChunk(id, cx, cy);
+            if(n > 0) allWallOres.increment(content.item(id), -n);
+        }
+        int x0 = cx << Tiles.chunkBits, y0 = cy << Tiles.chunkBits;
+        for(int y = y0; y < y0 + Tiles.chunkSize; y++){
+            for(int x = x0; x < x0 + Tiles.chunkSize; x++){
+                Tile tile = world.tiles.get(x, y);
+                if(tile != null && tile.floor().flags.size > 0) removeFloorIndex(tile, tile.floor());
+            }
+        }
+        updatePresentOres();
+    }
