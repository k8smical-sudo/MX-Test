diff --git a/core/src/mindustry/ai/RingOreIndex.java b/core/src/mindustry/ai/RingOreIndex.java
new file mode 100644
index 0000000000000000000000000000000000000000..704b5832342ce871571d198de32e2feed8eb18fd
--- /dev/null
+++ b/core/src/mindustry/ai/RingOreIndex.java
@@ -0,0 +1,71 @@
+package mindustry.ai;
+
+import arc.func.*;
+import arc.struct.*;
+import arc.util.*;
+
+/**
+ * Índice de menas de un mundo en anillo. Hace lo que las matrices {@code IntSeq[item][qx][qy]} de {@link BlockIndexer} en un mapa
+ * normal, pero con coordenadas virtuales (negativas incluidas) y sin depender del tamaño del mundo: un mapa por item, con clave
+ * de cuadrante. Los cuadrantes miden 16 casillas, alineados a los chunks de 32, así que cada cuadrante vive entero dentro de un
+ * chunk y descargarlo es quitar 4 entradas, sin buscar casilla a casilla.
+ * <p>
+ * Cada lista guarda {@code Tile.pos()} (coordenadas empaquetadas con signo), igual que en el índice normal.
+ */
+final class RingOreIndex{
+    /** Un cuadrante mide 1 << quadBits casillas; debe dividir al chunk (32). */
+    static final int quadBits = 4;
+    private static final int quadsPerChunkSide = 32 >> quadBits;
+
+    private final LongMap<IntSeq>[] byItem;
+
+    @SuppressWarnings("unchecked")
+    RingOreIndex(int items){
+        byItem = new LongMap[items];
+    }
+
+    int items(){
+        return byItem.length;
+    }
+
+    static long key(int x, int y){
+        return ((long)(x >> quadBits) << 32) | ((y >> quadBits) & 0xFFFFFFFFL);
+    }
+
+    /** @return the quadrant list of (x, y) for this item, or null if it doesn't exist and {@code create} is false (or the id is out of range). */
+    @Nullable IntSeq seq(int id, int x, int y, boolean create){
+        if(id < 0 || id >= byItem.length) return null;
+        LongMap<IntSeq> map = byItem[id];
+        if(map == null){
+            if(!create) return null;
+            map = byItem[id] = new LongMap<>();
+        }
+        long k = key(x, y);
+        IntSeq s = map.get(k);
+        if(s == null && create) map.put(k, s = new IntSeq(false, 16));
+        return s;
+    }
+
+    /** @return the quadrant lists of an item (iterate with values()); null if the item has none. */
+    @Nullable LongMap<IntSeq> map(int id){
+        return id >= 0 && id < byItem.length ? byItem[id] : null;
+    }
+
+    /** Quita todos los cuadrantes del chunk (cx, cy) de este item. @return cuántas menas tenían. */
+    int dropChunk(int id, int cx, int cy){
+        if(id < 0 || id >= byItem.length || byItem[id] == null) return 0;
+        LongMap<IntSeq> map = byItem[id];
+        int removed = 0;
+        for(int qy = 0; qy < quadsPerChunkSide; qy++){
+            for(int qx = 0; qx < quadsPerChunkSide; qx++){
+                IntSeq s = map.remove(key((cx << 5) + (qx << quadBits), (cy << 5) + (qy << quadBits)));
+                if(s != null) removed += s.size;
+            }
+        }
+        return removed;
+    }
+
+    void clear(){
+        for(int i = 0; i < byItem.length; i++) byItem[i] = null;
+    }
+}
